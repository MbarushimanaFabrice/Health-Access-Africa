# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/health_access_africa

# Secret used to sign JWT access tokens — replace with a long random string
JWT_SECRET=replace-with-a-long-random-string

# Access token lifetime
JWT_EXPIRES_IN=7d

# Port the API listens on
PORT=4441

# Allowed browser origin — must match the frontend URL exactly
CORS_ORIGIN=http://localhost:8080

NODE_ENV=development
